# Copy this file to .env and change the values if needed.
# Every setting is optional: the defaults below are used when .env is missing.

# The three models the assistant can switch between.
# Granite replaces watsonx ibm/granite-4-h-small
GRANITE_MODEL=granite4:tiny-h
# Llama replaces watsonx meta-llama/llama-4-maverick-17b-128e-instruct-fp8
LLAMA_MODEL=llama3.2:3b
# Mistral replaces watsonx mistralai/mistral-small-3-1-24b-instruct-2503
MISTRAL_MODEL=mistral:7b

# Where Ollama is running
OLLAMA_BASE_URL=http://localhost:11434
